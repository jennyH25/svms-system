{
  "name": "svms-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run api:dev\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:full": "npm run dev",
    "build": "vite build",
    "build:vercel": "node scripts/vercel-prepare-db.mjs && vite build",
    "start": "node server/index.js",
    "api:start": "node server/index.js",
    "api:dev": "nodemon --watch server --watch .env --ext js,mjs,cjs,json --ignore src --ignore dist --ignore public --ignore scripts server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:test": "node scripts/test-postgres.js",
    "db:setup-auth": "node scripts/setup-auth-db.js",
    "db:prepare:vercel": "node scripts/vercel-prepare-db.mjs",
    "test:archive-import": "node scripts/test-archive-import.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "gsap": "^3.14.2",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.575.0",
    "motion": "^12.34.3",
    "multer": "^2.1.1",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.7",
    "pusher": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "pusher-js": "^8.0.1",
    "tailwindcss": "^3.4.4",
    "vite": "^7.3.1"
  }
}
